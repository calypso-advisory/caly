# Adresse publique du site (sitemap, liens des alertes e-mail)
NEXT_PUBLIC_SITE_URL=https://www.calypso-advisory.com

# Supabase (Project Settings > API). Choisir une région européenne (Paris ou Francfort).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète, côté serveur uniquement. Ne jamais l'exposer dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Comptes autorisés à ouvrir /admin (séparés par des virgules)
ADMIN_EMAILS=

# Alerte e-mail à chaque nouvelle demande (facultatif, via Resend)
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=Calypso Advisory <site@calypso-advisory.com>
